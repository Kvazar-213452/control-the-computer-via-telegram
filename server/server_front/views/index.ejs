<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Завантаження файлу</title>
  <link rel="stylesheet" href="asets/main.css">
</head>
<body>
  <h1>Завантажте файл разом із текстом</h1>
  <form action="/upload_music" method="POST" enctype="multipart/form-data">
    <label for="text">Введіть текст:</label>
    <input type="text" id="text" name="text" required>
    <br><br>
    <label for="file">Виберіть файл:</label>
    <input type="file" id="file" name="file" required>
    <br><br>
    <button type="submit">Завантажити</button>
  </form>
  <form action="/upload_foto" method="POST" enctype="multipart/form-data">
    <label for="text">ps:</label>
    <input type="text" id="text" name="text" required>
    <br><br>
    <label for="file">Виберіть файл:</label>
    <input type="file" id="file" name="file" required>
    <br><br>
    <button type="submit">Завантажити</button>
  </form>
</body>
</html>
