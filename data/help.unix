-- команди
1. #help - полезна команда
2. #off - вирубає бота
3. #sound [0-100] - міняє силу звука на PC
4. #mouse [0-20] - зміна скорості мишки
5. #temp - видалить кеш
6. #music [1] - врубає музику
7. #sleep - соний режим PC
8. #shutdown - вирубає PC
9. #reboot - перезавантажує PC
10. #key [клавіша] - натискає клавішу [доступно невсі через перепис на C]
11. #text [текст] - відправляє вказаний текст
12. #foto [індекс] - вибирає фото
13. #bot1 - соний режим бота
14. #bot0 - активує бота
15. #data_log - виведе логи
16. #data_music - виведе інформацію про звукові файли в json
17. #data_foto - виведе інформацію про фото в json
18. #up_music - треба видіслати mp3 файл і в описі вказати номер викликаючого звука якщо номер існує він перезапишиться новим
19. #up_foto - треба видіслати фото і в описі вказати номер викликаючого фото якщо номер існує він перезапишиться новим
20. #close - alt f4
21. #sminer - запустити майнер
22. #pminer - вимкнути майнер
23. #bg - відправка фото і в описі команда зміна фона робочого стола

-- unix-f
!при відсилання gif вона відкриється як програма через NM1 на 5с
