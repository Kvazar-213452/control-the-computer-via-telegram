1. #help - полезна команда
2. #off - вирубає бота
3. #sound [0-100] - міняє силу звука на PC
4. #mouse [0-20] - зміна скорості мишки
6. #music [1] - врубає музику
7. #sleep - соний режим PC
8. #shutdown - вирубає PC
9. #reboot - перезавантажує PC
10. #key [клавіша] - натискає клавішу
11. #text [текст] - відправляє вказаний текст
12. #foto [індекс] - вибирає фото
13. #bot1 - соний режим бота
14. #bot0 - активує бота